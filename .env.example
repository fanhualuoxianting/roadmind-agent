MYSQL_DATABASE=roadmind
MYSQL_USER=roadmind
MYSQL_PASSWORD=replace-with-local-dev-secret
MYSQL_ROOT_PASSWORD=replace-with-another-local-secret
MYSQL_PORT=3307

REDIS_PASSWORD=replace-with-local-dev-secret
REDIS_PORT=6380

SERVER_PORT=8080
SIMULATOR_PORT=8081
WEB_PORT=5173
VEHICLE_SIMULATOR_BASE_URL=http://localhost:8081

# Safe defaults: deterministic planner and explicit stub data sources.
ROADMIND_AGENT_MODE=RULE_STUB
SPRING_AI_MODEL_CHAT=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
WEATHER_MODE=STUB
ROUTE_MODE=STUB
AMAP_WEB_SERVICE_KEY=
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# Optional read-only MCP bridge. Keep both values disabled unless you explicitly test MCP.
# When enabled, set both variables to the same long random local token.
MCP_SERVER_PORT=8090
ROADMIND_SERVER_BASE_URL=http://127.0.0.1:8080
ROADMIND_INTERNAL_TOKEN=disabled
ROADMIND_MCP_TOKEN=disabled
